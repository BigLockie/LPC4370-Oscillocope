	(text "When one of Pins 1(SEL1), 10(SEL2) or 11(SEL3) 20(SEL4) is pulled high,\nsends Vsig through specified attenuation path.\nRf1: 0.256x\nRf2: 0.833x\nRf3: 2.564x\nRf4: 10x\nPlace decoupling caps close to pins\n"
		(exclude_from_sim no)
		(at 54.102 219.202 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3f531b8a-18a7-40e7-8e53-57b799e37005")
	)
	(text "3.3V max is also the max input to the ADCHS\n without frying it\n"
		(exclude_from_sim no)
		(at 144.78 200.406 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "592d91bd-b543-4cdc-8157-60f076dda1cc")
	)
	(text "Place Cap as close to ADC as possible\n"
		(exclude_from_sim no)
		(at 227.838 247.142 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "7232a0e3-c96b-4885-ad28-69f50c176b1b")
	)
	(text "Cutoff frequency of 10.26MHz, realistic Bandwidth of 5MHz. \nCutoff selected to filter noise from the 12MHz external clock\nWith parasitic capacitances, this should be about 10MHz cutoff."
		(exclude_from_sim no)
		(at 233.172 238.252 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ab52c060-50f6-4a67-a54b-5be194603b40")
	)
	(text "+-15V Input Limits without clipping\n"
		(exclude_from_sim no)
		(at 36.83 136.398 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d6e95bba-25b5-41d6-bb34-55e15e017fc6")
	)
	(text "BNC"
		(exclude_from_sim no)
		(at 25.654 109.474 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "dc77944d-3fa7-4cb6-a5c8-3396848135c3")
	)
	(text "Summing Config: Vref ADC and incoming signal\n(800mVpp MAX), First two op amps will clip the signal if it exceeds \nthe specified voltage rails, protecting ADC\n"
		(exclude_from_sim no)
		(at 248.158 172.974 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "df6803db-3403-43e3-829b-bbf813880a98")
	)
	(text "INVERTS SIGNAL\nAccount for in software\n"
		(exclude_from_sim no)
		(at 167.386 155.194 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e827dfb6-118e-4757-946a-7e125f043221")
	)
	(text "Use a 10x Probe\n"
		(exclude_from_sim no)
		(at 35.306 133.35 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
